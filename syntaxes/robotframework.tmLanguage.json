{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Robot Framework",
  "scopeName": "source.robotframework",
  "fileTypes": [
    "robot",
    "resource"
  ],
  "patterns": [
    {
      "include": "#sections"
    },
    {
      "include": "#common"
    }
  ],
  "repository": {
    "sections": {
      "patterns": [
        {
          "name": "meta.section.settings.robotframework",
          "begin": "(?i)^(?:[ \\t]*\\|[ \\t]*)?\\*{3,}[ \\t]*Settings?[ \\t]*\\*{3,}(?:[ \\t]*\\|)?[ \\t]*$",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.section.robotframework"
            }
          },
          "end": "(?=^(?:[ \\t]*\\|[ \\t]*)?\\*{3,})",
          "patterns": [
            {
              "name": "keyword.other.setting.robotframework",
              "match": "(?i)^(?:[ \\t]*\\|[ \\t]*)?(?:Documentation|Metadata|Library|Resource|Variables|Suite Setup|Suite Teardown|Test Setup|Test Teardown|Task Setup|Task Teardown|Test Template|Task Template|Test Timeout|Task Timeout|Test Tags|Task Tags|Force Tags|Default Tags|Name)(?= {2,}|\\t|[ \\t]*\\||$)"
            },
            {
              "include": "#common"
            },
            {
              "include": "#arguments"
            }
          ]
        },
        {
          "name": "meta.section.variables.robotframework",
          "begin": "(?i)^(?:[ \\t]*\\|[ \\t]*)?\\*{3,}[ \\t]*Variables?[ \\t]*\\*{3,}(?:[ \\t]*\\|)?[ \\t]*$",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.section.robotframework"
            }
          },
          "end": "(?=^(?:[ \\t]*\\|[ \\t]*)?\\*{3,})",
          "patterns": [
            {
              "include": "#common"
            },
            {
              "include": "#arguments"
            }
          ]
        },
        {
          "name": "meta.section.tests.robotframework",
          "begin": "(?i)^(?:[ \\t]*\\|[ \\t]*)?\\*{3,}[ \\t]*(?:Test Cases?|Tasks?)[ \\t]*\\*{3,}(?:[ \\t]*\\|)?[ \\t]*$",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.section.robotframework"
            }
          },
          "end": "(?=^(?:[ \\t]*\\|[ \\t]*)?\\*{3,})",
          "patterns": [
            {
              "begin": "^(?=[^\\s#*|])",
              "end": "(?= {2,}|\\t|$)",
              "contentName": "entity.name.function.test.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            },
            {
              "begin": "^\\|[ \\t]*(?=[^\\s|#*])",
              "end": "(?=[ \\t]*\\|)|$",
              "contentName": "entity.name.function.test.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            },
            {
              "include": "#common"
            },
            {
              "begin": "^(?: {2,}|\\t+|\\|[ \\t]*\\|[ \\t]*)(FOR)(?= {2,}|\\t|[ \\t]*\\||$)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.control.robotframework"
                }
              },
              "end": "$",
              "patterns": [
                {
                  "include": "#variables"
                },
                {
                  "name": "keyword.operator.word.robotframework",
                  "match": "(?: {2,}|\\t+|\\|[ \\t]*)(IN(?: RANGE| ENUMERATE| ZIP)?)(?= {2,}|\\t|[ \\t]*\\||$)"
                },
                {
                  "include": "#arguments"
                }
              ]
            },
            {
              "name": "keyword.control.robotframework",
              "match": "(?i)^(?:(?: {2,}|\\t+)|\\|[ \\t]*\\|[ \\t]*)(?:ELSE IF|IF|ELSE|END|FOR|IN RANGE|IN ENUMERATE|IN ZIP|IN|WHILE|TRY|EXCEPT|FINALLY|RETURN|BREAK|CONTINUE|VAR|GROUP)(?= {2,}|\\t|[ \\t]*\\||$)"
            },
            {
              "begin": "^(?:(?: {2,}|\\t+)|\\|[ \\t]*\\|[ \\t]*)(?:((?:[$@&%]\\{[^}\\r\\n]*\\}(?:\\[[^\\]\\r\\n]*\\])*)(?:[ \\t]*=)?)(?: {2,}|\\t+|[ \\t]*\\|[ \\t]*))?",
              "end": "(?= {2,}|\\t|[ \\t]*\\||$)",
              "contentName": "entity.name.function.call.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ],
              "beginCaptures": {
                "1": {
                  "name": "meta.assignment.robotframework",
                  "patterns": [
                    {
                      "include": "#variables"
                    }
                  ]
                }
              }
            },
            {
              "include": "#arguments"
            }
          ]
        },
        {
          "name": "meta.section.keywords.robotframework",
          "begin": "(?i)^(?:[ \\t]*\\|[ \\t]*)?\\*{3,}[ \\t]*Keywords?[ \\t]*\\*{3,}(?:[ \\t]*\\|)?[ \\t]*$",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.section.robotframework"
            }
          },
          "end": "(?=^(?:[ \\t]*\\|[ \\t]*)?\\*{3,})",
          "patterns": [
            {
              "begin": "^(?=[^\\s#*|])",
              "end": "(?= {2,}|\\t|$)",
              "contentName": "entity.name.function.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            },
            {
              "begin": "^\\|[ \\t]*(?=[^\\s|#*])",
              "end": "(?=[ \\t]*\\|)|$",
              "contentName": "entity.name.function.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ]
            },
            {
              "include": "#common"
            },
            {
              "begin": "^(?: {2,}|\\t+|\\|[ \\t]*\\|[ \\t]*)(FOR)(?= {2,}|\\t|[ \\t]*\\||$)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.control.robotframework"
                }
              },
              "end": "$",
              "patterns": [
                {
                  "include": "#variables"
                },
                {
                  "name": "keyword.operator.word.robotframework",
                  "match": "(?: {2,}|\\t+|\\|[ \\t]*)(IN(?: RANGE| ENUMERATE| ZIP)?)(?= {2,}|\\t|[ \\t]*\\||$)"
                },
                {
                  "include": "#arguments"
                }
              ]
            },
            {
              "name": "keyword.control.robotframework",
              "match": "(?i)^(?:(?: {2,}|\\t+)|\\|[ \\t]*\\|[ \\t]*)(?:ELSE IF|IF|ELSE|END|FOR|IN RANGE|IN ENUMERATE|IN ZIP|IN|WHILE|TRY|EXCEPT|FINALLY|RETURN|BREAK|CONTINUE|VAR|GROUP)(?= {2,}|\\t|[ \\t]*\\||$)"
            },
            {
              "begin": "^(?:(?: {2,}|\\t+)|\\|[ \\t]*\\|[ \\t]*)(?:((?:[$@&%]\\{[^}\\r\\n]*\\}(?:\\[[^\\]\\r\\n]*\\])*)(?:[ \\t]*=)?)(?: {2,}|\\t+|[ \\t]*\\|[ \\t]*))?",
              "end": "(?= {2,}|\\t|[ \\t]*\\||$)",
              "contentName": "entity.name.function.call.robotframework",
              "patterns": [
                {
                  "include": "#variables"
                }
              ],
              "beginCaptures": {
                "1": {
                  "name": "meta.assignment.robotframework",
                  "patterns": [
                    {
                      "include": "#variables"
                    }
                  ]
                }
              }
            },
            {
              "include": "#arguments"
            }
          ]
        },
        {
          "name": "comment.block.robotframework",
          "begin": "(?i)^(?:[ \\t]*\\|[ \\t]*)?\\*{3,}[ \\t]*Comments?[ \\t]*\\*{3,}(?:[ \\t]*\\|)?[ \\t]*$",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.section.robotframework"
            }
          },
          "end": "(?=^(?:[ \\t]*\\|[ \\t]*)?\\*{3,})",
          "patterns": []
        }
      ]
    },
    "common": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#variables"
        },
        {
          "name": "punctuation.separator.continuation.robotframework",
          "match": "^(?:[ \\t]+|\\|[ \\t]*\\|[ \\t]*)\\.\\.\\.(?=[ \\t|]|$)"
        },
        {
          "name": "keyword.other.setting.robotframework",
          "match": "(?i)^(?:[ \\t]+|\\|[ \\t]*\\|[ \\t]*)\\[(?:Documentation|Tags|Setup|Teardown|Template|Timeout|Arguments|Return)\\]"
        },
        {
          "name": "constant.character.escape.robotframework",
          "match": "\\\\."
        }
      ]
    },
    "comments": {
      "name": "comment.line.number-sign.robotframework",
      "match": "(?:^[ \\t]*| {2,}|\\t|\\|)[ \\t]*(#.*)$"
    },
    "variables": {
      "name": "variable.other.robotframework",
      "begin": "(?<!\\\\)[$@&%]\\{",
      "end": "(?<!\\\\)\\}|(?=$)",
      "patterns": [
        {
          "name": "constant.character.escape.robotframework",
          "match": "\\\\."
        },
        {
          "include": "#variables"
        },
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.variable.begin.robotframework"
            }
          },
          "end": "(?<!\\\\)\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.variable.end.robotframework"
            }
          },
          "patterns": [
            {
              "include": "#variables"
            }
          ]
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.variable.begin.robotframework"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.variable.end.robotframework"
        }
      }
    },
    "arguments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.robotframework",
          "match": "(?:(?<=\\S)(?: {2,}|\\t+)|[ \\t]*\\|[ \\t]*)#.*$"
        },
        {
          "begin": "(?<=\\S)(?: {2,}|\\t+)|[ \\t]*\\|[ \\t]*",
          "end": "(?= {2,}|\\t|[ \\t]*\\||$)",
          "contentName": "string.unquoted.argument.robotframework",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#variables"
            },
            {
              "match": "\\G([\\p{L}_][\\p{L}\\p{N}_-]*)(=)",
              "captures": {
                "1": {
                  "name": "variable.parameter.named.robotframework"
                },
                "2": {
                  "name": "variable.parameter.named.robotframework"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
